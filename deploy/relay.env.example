# Copy to /etc/agent-bridge/relay.env, chmod 600, owned by the user that runs the relay.
# One NAME=value per line. No quotes, no "export". The file is read as data, so & $ ; and spaces in a value are fine.

# where the relay keeps bindings and device tokens (back this up)
RELAY_STATE=/var/lib/agent-bridge

# Feishu self-built app
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=replace-me

# the address phones and Feishu use (nginx, https). Also what the QR code points at.
FEISHU_REDIRECT_BASE=https://relay.example.com:9010

# where the computers connect (TLS). The plugin learns this from the relay over https.
RELAY_TUNNEL_URL=tls://relay.example.com:9011

# certificate for the tunnel: the FULL CHAIN (your certificate followed by the intermediates), and its key
RELAY_TLS_CERT=/etc/nginx/ssl/fullchain.pem
RELAY_TLS_KEY=/etc/nginx/ssl/privkey.pem

# optional, these are the defaults
#RELAY_HTTP_LISTEN=127.0.0.1:19011
#RELAY_TUNNEL_LISTEN=0.0.0.0:9011
